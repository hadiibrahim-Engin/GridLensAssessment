ef="1113" type="DataBand" isKey="true"><Brush>Transparent</Brush><BusinessObjectGuid isNull="true" /><CanBreak>False</CanBreak><ClientRectangle>0,360.97,26.7,2.4</ClientRectangle><Components isList="true" count="1"><AppendixIndexText_Text Ref="1114" type="Text" isKey="true"><Border>All;[190:195:205];0.5;Solid;False;4;Black</Border><Brush>[247:248:250]</Brush><CanGrow>True</CanGrow><ClientRectangle>0.2,0.1,26.3,2.1999999999999997</ClientRectangle><Conditions isList="true" count="0" /><Expressions isList="true" count="0" /><Font>Segoe UI,10</Font><Margins>0.3,0.3,0.1,0.1</Margins><Name>AppendixIndexText_Text</Name><Page isRef="22" /><Parent isRef="1113" /><Text>A  Lines - maximum loading within the simulation window [%]
B  Transformers - maximum loading within the simulation window [%]
C  Terminals / busbars - minimum node voltage within the simulation window [p.u.]</Text><TextBrush>[55:55:55]</TextBrush><TextOptions>,,,,WordWrap=True,A=0</TextOptions><VertAlignment>Center</VertAlignment></AppendixIndexText_Text></Components><Conditions isList="true" count="0" /><DataSourceName>ScriptedReportMeta</DataSourceName><Expressions isList="true" count="0" /><Filters isList="true" count="0" /><Name>AppendixIndexText_Band</Name><Page isRef="22" /><Parent isRef="22" /><Sort isList="true" count="0" /></AppendixIndexText_Band><AppendixConvention_Band Ref="1115" type="DataBand" isKey="true"><Brush>Transparent</Brush><BusinessObjectGuid isNull="true" /><CanBreak>False</CanBreak><ClientRectangle>0,363.47,26.7,1.8</ClientRectangle><Components isList="true" count="1"><AppendixConvention_Text Ref="1116" type="Text" isKey="true"><Border>All;[190:195:205];0.5;Solid;False;4;Black</Border><Brush>[247:248:250]</Brush><CanGrow>True</CanGrow><ClientRectangle>0.2,0.1,26.3,1.6</ClientRectangle><Conditions isList="true" count="0" /><Expressions isList="true" count="0" /><Font>Segoe UI,8.5</Font><Margins>0.3,0.3,0.1,0.1</Margins><Name>AppendixConvention_Text</Name><Page isRef="22" /><Parent isRef="1115" /><Text>Each value is derived from the same quasi-dynamic simulation window. Out-of-service or unavailable results are displayed as n/a. Loading tables list the elements that reach 80 % or change by 1 percentage point; voltage tables list the nodes outside their band or changing by 0.005 p.u. or more.</Text><TextBrush>[55:55:55]</TextBrush><TextOptions>,,,,WordWrap=True,A=0</TextOptions><VertAlignment>Center</VertAlignment></AppendixConvention_Text></Components><Conditions isList="true" count="0" /><DataSourceName>ScriptedReportMeta</DataSourceName><Expressions isList="true" count="0" /><Filters isList="true" count="0" /><Name>AppendixConvention_Band</Name><Page isRef="22" /><Parent isRef="22" /><Sort isList="true" count="0" /></AppendixConvention_Band><appa_TitleBand Ref="111